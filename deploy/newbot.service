[Unit]
Description=BC.GAME NewBot Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=myserver
WorkingDirectory=/home/myserver/DATA/bcgame/TGbot/newbot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/myserver/DATA/bcgame/TGbot/newbot/.venv/bin/python /home/myserver/DATA/bcgame/TGbot/newbot/bot.py
Restart=always
RestartSec=5
TimeoutStopSec=30
StandardOutput=append:/home/myserver/DATA/bcgame/TGbot/newbot/logs/newbot.log
StandardError=append:/home/myserver/DATA/bcgame/TGbot/newbot/logs/newbot.log

[Install]
WantedBy=multi-user.target
